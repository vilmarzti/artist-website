---
import '../css/pages/column.sass'

import GeneralLayout from '../layouts/GeneralLayout.astro'
import PictureDisplay from '../components/PictureDisplay.astro'
import Text from '../components/Text.astro'

import { getEntry } from 'astro:content'

const pic = await getEntry('pictures', 'Portrait')
const text_content = await getEntry('text', 'about')
---

<GeneralLayout title="About">

<div class="body-container">
    <div class="left-container">
        <div class="title">
            About
        </div>
        <Text text={text_content}/>
    </div>

    <div class="right-container">
        <div class="pic">
            <PictureDisplay picture={pic} attribution="below" />
        </div>
    </div>
</div>

</GeneralLayout>
