---
import "../css/pages/about.sass"

import GeneralLayout from '../layouts/GeneralLayout.astro'
import PictureDisplay from '../components/PictureDisplay.astro'
import Text from '../components/Text.astro'

import { getCollection, getEntry } from 'astro:content'


const pic = await getEntry('pictures', 'Nachtvolk')
const text_content = await getEntry('text', 'index')
---

<GeneralLayout title="Home Page">

<div class="body-container">
    <div class="pic">
        <PictureDisplay picture={pic} attribution="below" />
    </div>
    <Text text={text_content}/>
</div>

</GeneralLayout>
