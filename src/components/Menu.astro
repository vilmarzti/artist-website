---
import "../css/components/Menu.sass"

import { getEntry } from 'astro:content'

import PictureDisplay from '../components/PictureDisplay.astro'

const picture = await getEntry('pictures', 'Banner')
---
<style>
    .menu-container

</style>

<div class="header-container">
    <div class="name-container">
        <div class="brand-container">
                <div class="text">
                    art by
                </div>

                <a class="artist-name" href="/">
                    <PictureDisplay picture={picture} attribution="None"/>
                </a>
            </div>
    </div>

    <div class="menu-container">
        <a class="menu-item" href="/">
           <div class="menu-item-name"> Home </div>
        </a>
        <a class="menu-item" href="/artwork/">
           <div class="menu-item-name"> Artwork </div>
        </a>

        <a class="menu-item" href="/credibility">
            <div class="menu-item-name">"Credibility"</div>
        </a>

        <a class="menu-item" href="/about">
            <div class="menu-item-name"> About</div>
        </a>
    </div>
</div>
