---
import "../css/components/Text.sass"
import { CollectionEntry } from 'astro:content'
import { base } from 'astro:config/client'

interface Props {
    text: CollectionEntry<'text'>,
}

const { text } = Astro.props
---


<div class="text-field">
    <div class="title">
        {text.data.title}
    </div>

    <div class="text">
        {text.body}
    </div>
</div>


