---
import '../css/components/PictureDisplay.sass'
import { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

interface Props {
picture: CollectionEntry<'pictures'>,
attribution: boolean
}

const { picture, attribution } = Astro.props

---


<div class="picture-containter">
    <div class="picture">
        <img src={picture.data.image} alt=""/>
    </div>
    <div class="label" display={ attribution ? "block" : "None"}>
        { picture.data.license }
        { picture.data.title }
    </div>
</div>
