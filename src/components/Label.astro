---
import '../css/components/Label.sass'
import { CollectionEntry } from 'astro:content'

interface Props {
picture: CollectionEntry<'pictures'>,
}

const { picture } = Astro.props
---

<div class="label-container">
   <div class="entry"> Title: { picture.data.title } ({ picture.data.date }) </div>
   <div class="entry"> Artist: Martin Villavicencio </div>
   <div class="entry"> Medium: { picture.data.medium } </div>
   <div class="entry"> Size: { picture.data.size } </div>
</div>
